# G3: rules shared by every server block of the gateway.
# Replaces the image's own includes/location_common.conf.template (health check and status page kept below).

# Rate limit for all pages; "burst" lets a page load its CSS and images in one go.
limit_req zone=per_ip burst=40 nodelay;

# Ban list: IP addresses you decided to block (edit gateway/deny.conf, then restart the proxy).
include /etc/nginx/gateway/deny.conf;

# Our own pages instead of nginx's "403 Forbidden ... nginx" (which also reveals the software).
error_page 403 /errors/blocked.html;
error_page 429 /errors/slow-down.html;

location ^~ /errors/ {
    internal;                         # only reachable as an error page, never by typing the URL
    allow all;                        # banned visitors must still be able to see why
    modsecurity off;                  # the page itself never needs inspecting
    ssi on;                           # lets the page print the time of the block
    root /usr/share/nginx/gateway;
}

# Login: slow down password guessing before PHP's own lockout even starts counting.
location = /login.php {
    limit_req zone=per_ip burst=40 nodelay;
    limit_req zone=login_post burst=5 nodelay;
    include includes/cors.conf;
    include includes/proxy_backend.conf;
}

# Webshells: a PHP file inside an upload or media folder is never legitimate.
location ~* ^/(?:uploads?|images?|img|media|files)/.*\.(?:php\d?|phtml|phar)$ {
    return 403;
}

# --- kept from the image ---
location /healthz {
    access_log off;
    add_header Content-Type text/plain;
    return 200 "OK";
}

location /metrics/nginx {
    access_log off;
    allow ${METRICS_ALLOW_FROM};
    deny ${METRICS_DENY_FROM};
    proxy_store off;
    stub_status;
}

error_page 500 502 503 504  /50x.html;
location = /50x.html {
    root /usr/share/nginx/html;
}
