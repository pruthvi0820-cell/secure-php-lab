# Rules for the app (http://localhost:8080 and https://app.localtest.me:8443).
# Replaces the image's own includes/location_common.conf.template (health check and status page kept below).

include includes/protect.conf;

# G4: ask Authelia whether the visitor is verified. Internal only; called by auth_request below.
location /internal/authelia/authz {
    internal;
    modsecurity off;    # the visitor's real request was already inspected; this internal check is a GET that
                        # still carries the form's Content-Length, which CRS rule 920170 would wrongly block
    # Plain HTTP cannot carry Authelia's secure cookie, so it is never "verified"; the 401 below sends the
    # visitor to the HTTPS site. Done here (after the WAF has checked the request), not with an early "return".
    if ($scheme = http) {
        return 401;
    }
    set $authelia_authz ${AUTHELIA_UPSTREAM}/api/authz/auth-request;
    proxy_pass $authelia_authz;
    proxy_set_header X-Original-Method $request_method;
    proxy_set_header X-Original-URL $scheme://$http_host$request_uri;   # $http_host keeps the :8443 port
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header Remote-User "";                                    # never forward a visitor's own value
    proxy_set_header Content-Length "";
    proxy_set_header Connection "";
    proxy_pass_request_body off;
    proxy_http_version 1.1;
}

# G4: the admin area (PHP login, register, logout, messages) is zero-trust:
# nobody reaches PHP for these pages without a password + phone code checked by Authelia first.
location ~ ^/(?:login|register|logout|messages)\.php$ {
    limit_req zone=per_ip burst=40 nodelay;
    limit_req zone=login_post burst=5 nodelay;      # password guessing, counted before Authelia is even asked

    auth_request /internal/authelia/authz;
    auth_request_set $user $upstream_http_remote_user;
    auth_request_set $groups $upstream_http_remote_groups;
    auth_request_set $redirection_url $upstream_http_location;
    error_page 401 =302 $admin_auth_redirect;       # not verified: HTTPS site / Authelia portal, then come back
    error_page 403 /errors/blocked.html;            # an error_page here replaces the inherited ones,
    error_page 429 /errors/slow-down.html;          # so the block pages are repeated

    include includes/cors.conf;
    include includes/proxy_backend.conf;
    # Set here, after the include, so a visitor can never send their own Remote-User header to PHP.
    proxy_set_header Remote-User $user;
    proxy_set_header Remote-Groups $groups;
}

# Webshells: a PHP file inside an upload or media folder is never legitimate.
location ~* ^/(?:uploads?|images?|img|media|files)/.*\.(?:php\d?|phtml|phar)$ {
    return 403;
}

# --- kept from the image ---
location /healthz {
    access_log off;
    add_header Content-Type text/plain;
    return 200 "OK";
}

location /metrics/nginx {
    access_log off;
    allow ${METRICS_ALLOW_FROM};
    deny ${METRICS_DENY_FROM};
    proxy_store off;
    stub_status;
}

error_page 500 502 503 504  /50x.html;
location = /50x.html {
    root /usr/share/nginx/html;
}
